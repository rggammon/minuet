export component MainWindow inherits Window {
    title: "Minuet";
    width: 1024px;
    height: 600px;
    background: #111b21;
    default-font-family: "DejaVu Sans";
    default-font-size: 22px;

    private property <int> touch-count: 0;

    VerticalLayout {
        padding: 40px;
        spacing: 24px;

        Text {
            text: "minuet";
            color: #82dfc4;
            font-size: 54px;
            font-weight: 700;
        }
        Text {
            text: "Spotify Connect / Home Assistant";
            color: #e8f2f0;
            font-size: 28px;
        }
        Rectangle {
            background: #1c2c35;
            border-radius: 16px;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "Development display test";
                    color: #e8f2f0;
                }
                Text {
                    text: "Slint + FemtoVG / OpenGL ES 3.0";
                    color: #a9bcc4;
                }
                Text {
                    text: "Playback is not connected yet.";
                    color: #a9bcc4;
                }
            }
        }
        Rectangle {
            height: 86px;
            background: touch-area.pressed ? #4cae96 : #82dfc4;
            border-radius: 16px;
            Text {
                text: root.touch-count == 0 ? "Tap to test touch" : "Touch events: " + root.touch-count;
                color: #111b21;
                horizontal-alignment: center;
                vertical-alignment: center;
                font-weight: 700;
            }
            touch-area := TouchArea {
                clicked => { root.touch-count += 1; }
            }
        }
    }
}

